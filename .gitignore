.venv/
venv/
.deps/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Experiment outputs. Metrics JSON is small and worth committing selectively;
# captured tensors and figures are not.
results/**/*.pt
results/**/*.npz
results/**/*.pdf
logs/

# Smoke output is throwaway by construction: reduced routing and perplexity budgets, so
# the numbers are directional only and must never be mistaken for a real sweep.
results/smoke/

# HuggingFace caches must live on course storage, never in the repo.
hf_cache/
datasets_cache/

.DS_Store
.env
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# Editor/tooling caches
.pytest_cache/
.ruff_cache/

# others/ holds everything that should not ship with the public repo, for two separate
# reasons. First, internal working material written for us rather than for a reader
# arriving from the paper: STATUS.md is a dated catch-up note, and prior_art.md and
# method_audit.md are candid literature and methodology audits. The paper, README and
# ARCHITECTURE supersede all three. Second, downloaded reference PDFs and course
# documents, which are retrievable from their sources and are not ours to redistribute.
others/

# Agent planning output; scaffolding from the build phase, superseded by the paper.
*.plan.md
