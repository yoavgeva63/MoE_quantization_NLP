% Verified: arXiv API, 2506.13329v3, published 2025-06-16.
% Runs experts at W4A4 with the router at W8A8 -- i.e. router protection is ALREADY
% their baseline, which is why we do not claim it as our novelty. Also benchmarks
% OLMoE-1B-7B, so our primary model's numbers are comparable to theirs.
@misc{fu2025eaquant,
  title         = {{EAQuant}: Enhancing Post-Training Quantization for {MoE} Models via
                   Expert-Aware Optimization},
  author        = {Zhongqian Fu and Tianyi Zhao and Ning Ding and Xianzhi Yu and
                   Xiaosong Li and Yehui Tang and Yunhe Wang},
  year          = {2025},
  eprint        = {2506.13329},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  url           = {https://arxiv.org/abs/2506.13329}
}

% Verified: arXiv API, 2606.05688v1, published 2026-06-04.
% The proposal's "Park et al. (2026)"; first author is indeed Hancheol Park.
